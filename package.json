{
  "name": "bemol-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bemol — bot de música para Discord",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "youtube-dl-exec": "^3.1.13",
    "youtube-sr": "^4.3.12"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  }
