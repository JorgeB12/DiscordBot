# Token del bot: Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN= 

# Application ID: Discord Developer Portal → General Information
DISCORD_CLIENT_ID=

# Opcional: registra slash commands solo en este servidor (más rápido en desarrollo)
DISCORD_GUILD_ID=

# Palabra para activar a Bemol en el chat
WAKE_WORD=Bemol

# Canal de texto de música (opcional). Ahí puedes usar pon/skip/cola sin decir Bemol
MUSIC_CHANNEL_ID=

# Opcional: cookies de YouTube si YouTube pide "confirmar que no eres un bot" (típico en servidores).
# Si dejas un archivo cookies.txt en la carpeta del proyecto se usa solo, sin configurar nada.
# YOUTUBE_COOKIES=C:\ruta\a\cookies.txt

# Volumen inicial (0-150)
DEFAULT_VOLUME=50

# --- Verificación de Discord ---
# Message Content es un intent privilegiado. Ponlo en false para no depender de él:
# el bot sigue funcionando con slash commands, botones y "@Bemol pon ...".
MESSAGE_CONTENT_INTENT=true

# Enlaces públicos a la política de privacidad y los términos (Discord los pide al verificar).
# Se muestran en /ayuda. Puedes publicar PRIVACY.md y TERMS.md en GitHub y pegar aquí sus URLs.
PRIVACY_URL=
TERMS_URL=
SUPPORT_URL=

# --- Audio que se envía a Discord ---
# Bitrate del codificador Opus (32-512). 96 es lo habitual en bots; 128 da algo más de calidad.
OPUS_BITRATE_KBPS=96
# Corrección de errores en banda (FEC). Ayuda con pérdida de paquetes, pero algunos clientes la llevan mal.
OPUS_FEC=false
# Cifrado de extremo a extremo de Discord (DAVE). Ponlo en false solo para diagnosticar audio robótico.
DAVE_ENCRYPTION=true
